ARG BASE_IMAGE=openexplorer/ai_toolchain_ubuntu_20_x5_cpu:v1.2.8-py310
FROM ${BASE_IMAGE}

ARG NODE_VERSION=22.23.2
ARG MOSS_VERSION=0.6.0
ARG PLAYWRIGHT_VERSION=1.62.1

USER root
RUN curl --fail --location --retry 3 \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
      --output /tmp/node.tar.gz \
    && mkdir -p /opt/node \
    && tar -xzf /tmp/node.tar.gz --strip-components=1 -C /opt/node \
    && rm /tmp/node.tar.gz

ENV PATH="/opt/node/bin:${PATH}"
RUN npm install --global "@rdk-moss/agent@${MOSS_VERSION}" \
    && npm cache clean --force

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && browser_path="$(find /opt/ms-playwright -type f -path '*/chrome-linux*/chrome' | head -n 1)" \
    && test -n "$browser_path" \
    && ln -s "$browser_path" /usr/local/bin/moss-chromium \
    && chmod -R a+rX /opt/ms-playwright \
    && npm cache clean --force
ENV MOSS_BROWSER_EXECUTABLE=/usr/local/bin/moss-chromium

RUN id -u moss-eval >/dev/null 2>&1 || useradd --create-home --uid 10001 moss-eval
USER moss-eval
WORKDIR /workspace

ENTRYPOINT []
CMD ["moss", "--version"]
