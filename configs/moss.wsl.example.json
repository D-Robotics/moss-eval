{
  "schema_version": "1.0",
  "output_root": "../.moss-eval/runs",
  "task_roots": ["../taskpacks/core"],
  "default_runner": "docker",
  "execution": {
    "concurrency": 1,
    "trials": null,
    "k": 3,
    "valid_trial_threshold": 0.95,
    "environment_overrides": {
      "network": "public"
    }
  },
  "runners": {
    "local": { "allow": false },
    "docker": {
      "command": "wsl",
      "prefix_args": ["--distribution", "RDK-Moss-Ubuntu", "--exec", "sudo", "docker"],
      "path_style": "wsl"
    },
    "pty": {}
  },
  "agents": {
    "moss": {
      "adapter": "moss",
      "command": "moss",
      "args": ["{instruction}"],
      "mode_commands": { "acp": "node" },
      "mode_base_args": {
        "acp": ["{evalRoot}/drivers/acp-client.mjs", "--server", "moss", "--server-args", "[\"agent\",\"stdio\"]", "--cwd", "{workspace}", "--prompt", "{instruction}"]
      },
      "mode_args": {
        "stream-json": ["--output-format", "stream-json", "--verbose"]
      },
      "provider": "configured-by-moss",
      "model": "configured-by-moss",
      "secret_env": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY"]
    },
    "reference": {
      "adapter": "command",
      "command": "node",
      "args": ["{evalRoot}/examples/reference-agent.mjs"],
      "provider": "deterministic",
      "model": "reference-oracle"
    }
  }
}
