  "artifacts": ["trajectory.jsonl", "final-response.txt", "workspace", "workspace-diff", "native-telemetry.json"],
  "reference_solution": { "kind": "task-specific-behavioral-controls", "version": "1" },
  "capability_requirements": {
    "schema_version": "1.0",
    "modes": ["stream-json"],
    "min_telemetry_level": "L0",
    "required_tools": [],
