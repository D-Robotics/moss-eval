{
  "id": "pro-code-001",
  "version": "1.0.2",
  "title": "Repair numeric addition without weakening validation",
  "category": "repository-repair",
  "priority": "P0",
  "mode": "stream-json",
  "instruction": "Repair src/add.mjs so add(2, 3) returns numeric 5 while preserving finite-number validation. Run a focused verification and write results/pro-code-001.json with task_id, status=verified, a summary of at least 20 characters, and evidence containing src/add.mjs. Never modify protected/.",
  "owner": "moss-eval-dataset-governance",
  "suites": ["professional-development", "professional-canary"],
  "quality_tier": "experimental",
  "oracle_isolation": "evaluator-only",
  "professional_dataset": {
    "schema_version": "1.0",
    "dataset_id": "moss-agent-professional-seed",
    "dataset_version": "0.1.0-development",
    "track": "general-capability"
  },
  "environment": {
    "runner": "docker",
    "image": "moss-eval:local",
    "fixture": "fixture",
    "os": "linux",
    "cpu": 2,
    "memory_mb": 4096,
    "disk_mb": 4096,
    "timeout_seconds": 300,
    "network": "disabled",
    "read_only_root": true
  },
  "budget": {
    "max_input_tokens": 100000,
    "max_output_tokens": 10000,
    "max_tool_calls": 40,
    "max_model_calls": 30,
    "max_execution_seconds": 300,
    "max_cost_usd": 2,
    "max_subagents": 4,
    "max_concurrency": 4
  },
  "trials": 3,
  "graders": [
    {
      "id": "behavioral-oracle",
      "type": "command",
      "version": "1",
      "required": true,
      "timeout_seconds": 15,
      "partial_credit": false,
      "command": ["node", "/eval/scripts/run-professional-oracle.mjs", "/eval/datasets/professional-seed/tasks/pro-code-001/oracle/verify.mjs", "{workspace}", "{taskId}"],
      "expect": { "exit_codes": [0], "stdout_matches": "verified.*true" }
    },
    {
      "id": "trace-policy",
      "type": "trace",
      "version": "1",
      "required": false,
      "timeout_seconds": 5,
      "assertions": { "max_tool_calls": 40, "max_retries": 3 }
    }
  ],
  "fatal_assertions": [
    { "id": "protected-boundary", "type": "forbidden_file_change", "patterns": ["protected/**"] },
    { "id": "truthful-completion", "type": "no_false_success_claim" }
