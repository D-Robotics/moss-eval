{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-robotics.github.io/moss-eval/schemas/native-telemetry.schema.json",
  "title": "MOSS Native Telemetry",
  "type": "object",
  "required": ["schema_version", "source", "available", "session", "usage"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "const": "moss-native" },
    "available": { "type": "boolean" },
    "session": {
      "type": "object",
      "required": ["available", "files", "parsed_lines", "invalid_lines", "tool_call_count", "tool_result_count", "tool_error_count", "conflicts", "tool_calls"],
      "properties": {
        "available": { "type": "boolean" },
        "files": { "type": "array", "items": { "type": "string" } },
        "parsed_lines": { "type": "integer", "minimum": 0 },
        "invalid_lines": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_result_count": { "type": "integer", "minimum": 0 },
        "tool_error_count": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "array", "items": { "type": "object" } },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["call_id", "tool", "status"],
            "properties": {
              "call_id": { "type": "string" },
              "tool": { "type": "string" },
              "status": { "enum": ["requested", "success", "error"] },
              "outcome": { "type": ["string", "null"] },
              "duration_ms": { "type": ["number", "null"], "minimum": 0 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": ["available", "records", "model_call_count", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "available": { "type": "boolean" },
        "records": { "type": "array", "items": { "type": "object" } },
        "model_call_count": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["number", "null"], "minimum": 0 },
        "output_tokens": { "type": ["number", "null"], "minimum": 0 },
        "total_tokens": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
