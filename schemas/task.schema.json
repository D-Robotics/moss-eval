{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-robotics.github.io/moss-eval/schemas/task.schema.json",
  "title": "MOSS Eval Task",
  "type": "object",
  "required": ["id", "version", "title", "category", "priority", "mode", "instruction", "owner", "environment", "budget", "trials", "graders", "fatal_assertions", "artifacts", "reference_solution"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,119}$" },
    "version": { "type": ["string", "integer"] },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "mode": { "enum": ["one-shot", "stream-json", "pty", "acp", "embedded", "browser", "device"] },
    "instruction": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "suites": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "environment": {
      "type": "object",
      "required": ["runner", "timeout_seconds"],
      "properties": {
        "runner": { "enum": ["local", "docker", "pty"] },
        "fixture": { "type": ["string", "null"] },
        "image": { "type": "string" },
        "image_digest": { "type": "string" },
        "os": { "type": "string" },
        "cpu": { "type": "number", "exclusiveMinimum": 0 },
        "memory_mb": { "type": "number", "exclusiveMinimum": 0 },
        "disk_mb": { "type": "number", "exclusiveMinimum": 0 },
        "pids": { "type": "integer", "exclusiveMinimum": 0 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "network": { "enum": ["disabled", "public", "allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string" } },
        "timezone": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "user": { "type": "string" },
        "read_only_root": { "type": "boolean" },
        "allowed_agent_exit_codes": { "type": "array", "items": { "type": "integer" } }
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_input_tokens": { "type": "number", "minimum": 0 },
        "max_output_tokens": { "type": "number", "minimum": 0 },
        "max_tokens": { "type": "number", "minimum": 0 },
        "max_tool_calls": { "type": "number", "minimum": 0 },
        "max_model_calls": { "type": "number", "minimum": 0 },
        "max_execution_seconds": { "type": "number", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_subagents": { "type": "number", "minimum": 0 },
        "max_concurrency": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "trials": { "type": "integer", "minimum": 1 },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "version", "required", "timeout_seconds"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["command", "file", "trace", "llm_rubric"] },
          "version": { "type": ["string", "integer"] },
          "required": { "type": "boolean" },
          "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "weight": { "type": "number", "minimum": 0 },
          "partial_credit": { "type": "boolean" },
          "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "assertions": {},
          "expect": { "type": "object" },
          "rubric": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "fatal_assertions": { "type": "array", "items": { "type": "object", "required": ["id", "type"] } },
    "faults": { "type": "array", "items": { "type": "object", "required": ["id", "type"] } },
    "tool_expectations": {
      "type": "object",
      "properties": {
        "expected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "required_any": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "required_all": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "max_calls": { "type": "integer", "minimum": 0 },
        "must_verify_after_mutation": { "type": "boolean" },
        "mutation_tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "verification_tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        ,"expected_order": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        ,"argument_requirements": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
      },
      "additionalProperties": false
    },
    "capability_requirements": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "1.0" },
        "modes": { "type": "array", "items": { "enum": ["one-shot", "stream-json", "pty", "acp", "embedded", "browser", "device"] }, "uniqueItems": true },
        "min_telemetry_level": { "enum": ["L0", "L1", "L2", "L3"] },
        "required_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_any_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "runners": { "type": "array", "items": { "enum": ["local", "docker", "pty"] }, "uniqueItems": true },
        "sandbox_features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "quality_tier": { "enum": ["gated", "experimental"] },
    "oracle": { "type": "object" },
    "allowed_alternate_paths": { "type": "array", "items": { "type": "string" } },
    "controls": { "type": "object" },
    "provenance": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "reference_solution": {}
  },
  "additionalProperties": true
}
